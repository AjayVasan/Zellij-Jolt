// zellij config fixture: 0.42+ component-based theme format.
// Shape per https://zellij.dev/documentation/themes.
// Same fg/bg as legacy.kdl and hex.kdl: base 244 244 244 / background 24 24 24.

themes {
    mytheme-component {
        text_unselected {
            base 244 244 244
            background 24 24 24
            emphasis_0 255 221 126
            emphasis_1 150 166 200
            emphasis_2 149 169 159
            emphasis_3 158 149 199
        }
        text_selected {
            base 244 244 244
            background 24 24 24
            emphasis_0 255 221 126
            emphasis_1 150 166 200
            emphasis_2 149 169 159
            emphasis_3 158 149 199
        }
        ribbon_unselected {
            base 24 24 24
            background 244 244 244
            emphasis_0 244 56 65
            emphasis_1 115 217 54
            emphasis_2 255 79 90
            emphasis_3 158 149 199
        }
        ribbon_selected {
            base 24 24 24
            background 255 221 126
            emphasis_0 244 56 65
            emphasis_1 115 217 54
            emphasis_2 255 79 90
            emphasis_3 158 149 199
        }
        table_title {
            base 244 244 244
            background 24 24 24
            emphasis_0 255 221 126
            emphasis_1 150 166 200
            emphasis_2 149 169 159
            emphasis_3 158 149 199
        }
        table_cell_unselected {
            base 244 244 244
            background 24 24 24
            emphasis_0 255 221 126
            emphasis_1 150 166 200
            emphasis_2 149 169 159
            emphasis_3 158 149 199
        }
        table_cell_selected {
            base 244 244 244
            background 24 24 24
            emphasis_0 255 221 126
            emphasis_1 150 166 200
            emphasis_2 149 169 159
            emphasis_3 158 149 199
        }
        list_unselected {
            base 244 244 244
            background 24 24 24
            emphasis_0 255 221 126
            emphasis_1 150 166 200
            emphasis_2 149 169 159
            emphasis_3 158 149 199
        }
        list_selected {
            base 244 244 244
            background 24 24 24
            emphasis_0 255 221 126
            emphasis_1 150 166 200
            emphasis_2 149 169 159
            emphasis_3 158 149 199
        }
        frame_unselected {
            base 244 244 244
            background 24 24 24
            emphasis_0 255 221 126
            emphasis_1 150 166 200
            emphasis_2 149 169 159
            emphasis_3 158 149 199
        }
        frame_selected {
            base 255 221 126
            background 24 24 24
            emphasis_0 244 56 65
            emphasis_1 115 217 54
            emphasis_2 255 79 90
            emphasis_3 158 149 199
        }
        frame_highlight {
            base 244 56 65
            background 24 24 24
            emphasis_0 244 56 65
            emphasis_1 115 217 54
            emphasis_2 255 79 90
            emphasis_3 158 149 199
        }
        exit_code_success {
            base 115 217 54
            background 24 24 24
            emphasis_0 244 244 244
            emphasis_1 244 244 244
            emphasis_2 244 244 244
            emphasis_3 244 244 244
        }
        exit_code_error {
            base 244 56 65
            background 24 24 24
            emphasis_0 244 244 244
            emphasis_1 244 244 244
            emphasis_2 244 244 244
            emphasis_3 244 244 244
        }
        multiplayer_user_colors {
            player_1 244 56 65
            player_2 115 217 54
            player_3 255 221 126
            player_4 150 166 200
            player_5 158 149 199
            player_6 255 79 90
            player_7 149 169 159
            player_8 0 0 0
            player_9 228 228 228
            player_10 244 244 244
        }
    }
}

theme "mytheme-component"
