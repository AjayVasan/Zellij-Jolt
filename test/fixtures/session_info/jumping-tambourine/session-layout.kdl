layout {
    cwd "/home/ajay"
    tab name="Bulk Data" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="claude" name="Bulk Datapulse" cwd="nitro/datapulse-nitro" {
            args "--dangerously-skip-permissions"
            start_suspended true
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="Tab #5" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="ssh" cwd="nitro/cookie-cutter" {
            args "user@example.com"
            start_suspended true
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="Tab #7" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane split_direction="vertical" {
            pane command="ssh" cwd="nitro/datapulse-nitro" size="50%" {
                args "user@example.com"
                start_suspended true
            }
            pane size="50%" {
                pane command="ssh" cwd="nitro/datapulse-nitro" size="20%" {
                    args "user@example.com"
                    start_suspended true
                }
                pane command="ssh" cwd="nitro/datapulse-nitro" size="80%" {
                    args "user@example.com"
                    start_suspended true
                }
            }
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="Token Broker" focus=true hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="claude" cwd="nitro/all_nitro" focus=true {
            args "--dangerously-skip-permissions"
            start_suspended true
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="Tab #9" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="claude" cwd="nitro/datapulse-nitro" {
            args "--dangerously-skip-permissions"
            start_suspended true
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="Tab #10" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="bash" {
            args "/home/ajay/.local/bin/claude-zellij" "--pane-id" "ae2e9576-c7d0-48b5-a30b-ffc0aa5cc34b" "--dangerously-skip-permissions" "--dangerously-skip-permissions"
            start_suspended true
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="Tab #11" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="ssh" {
            args "user@example.com"
            start_suspended true
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="zellij zolt" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="bash" cwd="Zellij-Jolt" {
            args "/home/ajay/.local/bin/claude-zellij" "--pane-id" "2238f628-500c-4dd0-be97-c465794134c8" "--dangerously-skip-permissions" "--dangerously-skip-permissions"
            start_suspended true
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    new_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane cwd="/home/ajay"
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    swap_tiled_layout name="vertical" {
        tab max_panes=5 {
            pane size=1 borderless=true {
                plugin location="zellij:tab-bar"
            }
            pane {
                pane split_direction="vertical" {
                    pane
                    pane {
                        children
                    }
                }
            }
            pane size=1 borderless=true {
                plugin location="zellij:status-bar"
            }
        }
        tab max_panes=8 {
            pane size=1 borderless=true {
                plugin location="zellij:tab-bar"
            }
            pane {
                pane split_direction="vertical" {
                    pane {
                        children
                    }
                    pane {
                        pane
                        pane
                        pane
                        pane
                    }
                }
            }
            pane size=1 borderless=true {
                plugin location="zellij:status-bar"
            }
        }
        tab max_panes=12 {
            pane size=1 borderless=true {
                plugin location="zellij:tab-bar"
            }
            pane {
                pane split_direction="vertical" {
                    pane {
                        children
                    }
                    pane {
                        pane
                        pane
                        pane
                        pane
                    }
                    pane {
                        pane
                        pane
                        pane
                        pane
                    }
                }
            }
            pane size=1 borderless=true {
                plugin location="zellij:status-bar"
            }
        }
    }
    swap_tiled_layout name="horizontal" {
        tab max_panes=4 {
            pane size=1 borderless=true {
                plugin location="zellij:tab-bar"
            }
            pane {
                pane
                pane
            }
            pane size=1 borderless=true {
                plugin location="zellij:status-bar"
            }
        }
        tab max_panes=8 {
            pane size=1 borderless=true {
                plugin location="zellij:tab-bar"
            }
            pane {
                pane {
                    pane split_direction="vertical" {
                        children
                    }
                    pane split_direction="vertical" {
                        pane
                        pane
                        pane
                        pane
                    }
                }
            }
            pane size=1 borderless=true {
                plugin location="zellij:status-bar"
            }
        }
        tab max_panes=12 {
            pane size=1 borderless=true {
                plugin location="zellij:tab-bar"
            }
            pane {
                pane {
                    pane split_direction="vertical" {
                        children
                    }
                    pane split_direction="vertical" {
                        pane
                        pane
                        pane
                        pane
                    }
                    pane split_direction="vertical" {
                        pane
                        pane
                        pane
                        pane
                    }
                }
            }
            pane size=1 borderless=true {
                plugin location="zellij:status-bar"
            }
        }
    }
    swap_tiled_layout name="stacked" {
        tab min_panes=4 {
            pane size=1 borderless=true {
                plugin location="zellij:tab-bar"
            }
            pane {
                pane stacked=true {
                    children
                }
            }
            pane size=1 borderless=true {
                plugin location="zellij:status-bar"
            }
        }
    }
    swap_tiled_layout name="half-stacked" {
        tab min_panes=5 {
            pane size=1 borderless=true {
                plugin location="zellij:tab-bar"
            }
            pane {
                pane split_direction="vertical" {
                    pane
                    pane stacked=true {
                        children
                    }
                }
            }
            pane size=1 borderless=true {
                plugin location="zellij:status-bar"
            }
        }
    }
    swap_floating_layout name="staggered" {
        floating_panes {
        }
    }
    swap_floating_layout name="enlarged" {
        floating_panes max_panes=10 {
            pane cwd="/home/ajay" {
                height "90%"
                width "90%"
                x "5%"
                y 1
            }
            pane cwd="/home/ajay" {
                height "90%"
                width "90%"
                x "5%"
                y 2
            }
            pane cwd="/home/ajay" {
                height "90%"
                width "90%"
                x "5%"
                y 3
            }
            pane cwd="/home/ajay" {
                height "90%"
                width "90%"
                x "5%"
                y 4
            }
            pane cwd="/home/ajay" {
                height "90%"
                width "90%"
                x "5%"
                y 5
            }
            pane cwd="/home/ajay" {
                height "90%"
                width "90%"
                x "5%"
                y 6
            }
            pane cwd="/home/ajay" {
                height "90%"
                width "90%"
                x "5%"
                y 7
            }
            pane cwd="/home/ajay" {
                height "90%"
                width "90%"
                x "5%"
                y 8
            }
            pane cwd="/home/ajay" {
                height "90%"
                width "90%"
                x "5%"
                y 9
            }
            pane cwd="/home/ajay" {
                height "90%"
                width "90%"
                x 10
                y 10
            }
        }
    }
    swap_floating_layout name="spread" {
        floating_panes max_panes=1 {
            pane cwd="/home/ajay" {
                x "50%"
                y "50%"
            }
        }
        floating_panes max_panes=2 {
            pane cwd="/home/ajay" {
                width "45%"
                x "1%"
                y "25%"
            }
            pane cwd="/home/ajay" {
                width "45%"
                x "50%"
                y "25%"
            }
        }
        floating_panes max_panes=3 {
            pane cwd="/home/ajay" {
                height "45%"
                width "45%"
                y "55%"
            }
            pane cwd="/home/ajay" {
                width "45%"
                x "1%"
                y "1%"
            }
            pane cwd="/home/ajay" {
                width "45%"
                x "50%"
                y "1%"
            }
        }
        floating_panes max_panes=4 {
            pane cwd="/home/ajay" {
                height "45%"
                width "45%"
                x "1%"
                y "55%"
            }
            pane cwd="/home/ajay" {
                height "45%"
                width "45%"
                x "50%"
                y "55%"
            }
            pane cwd="/home/ajay" {
                height "45%"
                width "45%"
                x "1%"
                y "1%"
            }
            pane cwd="/home/ajay" {
                height "45%"
                width "45%"
